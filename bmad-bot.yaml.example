# BMAD Bot Configuration
# Copy this file to bmad-bot.yaml and fill in your values.

# How often (seconds) the daemon polls sprint-status.yaml for new stories.
# Default: 300 (5 minutes)
polling_interval_secs: 300

# Logging configuration
# log_format: "pretty" for human-readable, "json" for structured (machine-parseable)
# Override at runtime with RUST_LOG env var for log level.
log_format: pretty            # "pretty" or "json" (default: pretty)
log_level: info               # "trace", "debug", "info", "warn", "error" (default: info)
log_file: bmad-bot.log        # Path to log file for `bmad-bot logs` command (default: bmad-bot.log)

# Git hosting provider for PR creation
git_provider:
  provider: github            # "github" or "gitlab"
  repo_owner: your-org
  repo_name: your-repo
  target_branch: main         # Branch that PRs target (default: main)

# LLM provider configuration — one provider+model per role
# Supported providers: "anthropic", "openai", "github-copilot"
# API keys are loaded from .env (see .env.example), never from this file.
#
# reasoning_effort (optional): controls reasoning depth for OpenAI-compatible models.
#   Values: "low", "medium", "high", "xhigh"
#   Only effective for OpenAI and GitHub Copilot providers using the Responses API.
#   Ignored for Anthropic and Copilot models routed through Chat Completions API.
llm:
  dev:
    provider: anthropic
    model: claude-sonnet-4-20250514
    # reasoning_effort: high  # uncomment for OpenAI/Copilot models
  review:
    provider: anthropic
    model: claude-sonnet-4-20250514
  supervisor:
    provider: anthropic
    model: claude-sonnet-4-20250514

# Notification channels
notifications:
  telegram:
    enabled: false
    chat_id: ""               # Your Telegram chat ID

# Automated code review after dev sessions (optional, default: true)
# When enabled, a separate LLM runs the BMAD CR workflow to review code before PR creation.
code_review_enabled: true

# External MCP servers — optional, defaults to none
# The daemon connects to these at startup, discovers their tools,
# and makes them available to the agent during sessions.
# mcp_servers:
#   - name: playwright
#     command: npx
#     args: ["@anthropic/mcp-playwright"]
#     transport: stdio          # "stdio" (default, only option for now)
#     enabled: true             # default: true — set false to skip
#     timeout_secs: 30          # handshake timeout in seconds (default: 30)

# BMAD project paths — adjust to match your project layout
bmad_paths:
  project_root: "."
  output_folder: "_bmad-output"
  planning_artifacts: "_bmad-output/planning-artifacts"
  implementation_artifacts: "_bmad-output/implementation-artifacts"
